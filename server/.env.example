# Smart Learning Center - server configuration
# Copy this file to .env and adjust as needed.

# HTTP + WebSocket port for the dashboard.
PORT=8080

# "rfc2217" connects to the Wokwi simulator's serial port (default).
# "demo" runs a server-side generator that mimics the ESP32 so the UI can
# be rehearsed without Wokwi running. The dashboard shows a DEMO MODE
# banner whenever this is active.
BRIDGE_MODE=rfc2217

# Wokwi's RFC2217 serial server (see firmware/wokwi.toml).
RFC2217_HOST=127.0.0.1
RFC2217_PORT=4000

# Signs the demo login session cookie. Change this for anything beyond a
# local classroom demo.
SESSION_SECRET=smart-learning-center-demo-secret
